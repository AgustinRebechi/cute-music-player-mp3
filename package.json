{
  "name": "para-agos",
  "version": "1.0.0",
  "description": "Reproductor mp3 para agosita",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Agustin Rebechi",
  "license": "ISC",
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "build": {
  "appId": "Para Agos",
  "productName": "Para Agos, con mucho amor",
  "files": [
    "main.js",
    "renderer.js",
    "index.html",
    "style.css",
    "songs/",
    "assets/"
  ],
  "win": {
    "target": "nsis",
    "icon": "assets/icon.ico"
  },
  "mac": {
    "target": "dmg",
    "icon": "assets/icon.icns"
  },
  "linux": {
    "target": "AppImage",
    "icon": "assets/icon.png"
  }
}
}
